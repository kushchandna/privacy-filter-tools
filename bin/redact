#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/.env"
  set +a
fi

IMAGE="${REDACT_IMAGE:-redact:latest}"
CHECKPOINT_DIR="${REDACT_CHECKPOINT_DIR:-.data/checkpoints}"
ADDITIONAL_DOCKER_RUN_ARGS="${REDACT_DOCKER_RUN_ARGS:-}"

tty_flag=()
[ -t 0 ] && tty_flag=(-t)

env_flags=()
[ -n "${HF_TOKEN:-}" ] && env_flags+=(-e HF_TOKEN)

# Rewrite -f <host_path> args so the referenced file is mounted into the
# container and opf sees the in-container path.
opf_args=()
file_mounts=()
file_idx=0
while [ $# -gt 0 ]; do
  case "$1" in
    -f)
      if [ $# -lt 2 ]; then
        echo "redact: -f requires a file path" >&2
        exit 2
      fi
      host_path="$2"
      if [ ! -f "$host_path" ]; then
        echo "redact: file not found: $host_path" >&2
        exit 2
      fi
      abs_path="$(cd "$(dirname "$host_path")" && pwd)/$(basename "$host_path")"
      container_path="/redact-input/${file_idx}/$(basename "$host_path")"
      file_mounts+=(-v "$abs_path:$container_path:ro")
      opf_args+=(-f "$container_path")
      file_idx=$((file_idx + 1))
      shift 2
      ;;
    *)
      opf_args+=("$1")
      shift
      ;;
  esac
done

exec docker run --rm -i "${tty_flag[@]}" \
  -v "$CHECKPOINT_DIR:/home/redact/.opf" \
  "${file_mounts[@]}" \
  "${env_flags[@]}" \
  "$IMAGE" $ADDITIONAL_DOCKER_RUN_ARGS "${opf_args[@]}"
