#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/.env"
  set +a
fi

IMAGE="${REDACT_IMAGE:-redact:latest}"
CHECKPOINTS_DIR="${REDACT_CHECKPOINT_DIR:-./.data/checkpoints}"
ADDITIONAL_DOCKER_RUN_ARGS="${REDACT_DOCKER_RUN_ARGS:-}"

# Resolve to absolute path so Docker treats it as a bind mount, not a named volume
mkdir -p "$CHECKPOINTS_DIR"
CHECKPOINTS_DIR="$(cd "$CHECKPOINTS_DIR" && pwd)"

OPF_CHECKPOINTS_PATH="${CHECKPOINTS_DIR}/opf"
DOCLING_ARTIFACTS_PATH="${CHECKPOINTS_DIR}/docling"
RAPIDOCR_MODELS_PATH="${CHECKPOINTS_DIR}/rapidocr"
mkdir -p "$OPF_CHECKPOINTS_PATH" "$DOCLING_ARTIFACTS_PATH" "$RAPIDOCR_MODELS_PATH"

tty_flag=()
[ -t 0 ] && tty_flag=(-t)

env_flags=()
[ -n "${HF_TOKEN:-}" ] && env_flags+=(-e HF_TOKEN)

# Rewrite -f <host_path> args so the parent directory is bind-mounted (rw)
# into the container and opf sees the in-container path. The host directory
# is also forwarded via REDACT_HOST_DIR_<idx> so the entrypoint can print
# host-relative paths in its summary output.
opf_args=()
file_mounts=()
host_dir_envs=()
file_idx=0
while [ $# -gt 0 ]; do
  case "$1" in
    -f)
      if [ $# -lt 2 ]; then
        echo "redact: -f requires a file path" >&2
        exit 2
      fi
      host_path="$2"
      if [ ! -f "$host_path" ]; then
        echo "redact: file not found: $host_path" >&2
        exit 2
      fi
      host_dir="$(cd "$(dirname "$host_path")" && pwd)"
      file_name="$(basename "$host_path")"
      container_dir="/redact-input/${file_idx}"
      container_path="${container_dir}/${file_name}"
      file_mounts+=(-v "${host_dir}:${container_dir}")
      host_dir_envs+=(-e "REDACT_HOST_DIR_${file_idx}=${host_dir}")
      opf_args+=(-f "$container_path")
      file_idx=$((file_idx + 1))
      shift 2
      ;;
    -o|--output)
      if [ $# -lt 2 ]; then
        echo "redact: $1 requires a file path" >&2
        exit 2
      fi
      host_out="$2"
      host_out_dir="$(mkdir -p "$(dirname "$host_out")" && cd "$(dirname "$host_out")" && pwd)"
      out_name="$(basename "$host_out")"
      container_out_dir="/redact-output"
      file_mounts+=(-v "${host_out_dir}:${container_out_dir}")
      opf_args+=("$1" "${container_out_dir}/${out_name}")
      shift 2
      ;;
    --checkpoint)
      if [ $# -lt 2 ]; then
        echo "redact: --checkpoint requires a path" >&2
        exit 2
      fi
      host_ckpt="$2"
      host_ckpt_abs="$(cd "$host_ckpt" && pwd)"
      container_ckpt="/redact-checkpoint"
      file_mounts+=(-v "${host_ckpt_abs}:${container_ckpt}:ro")
      opf_args+=(--checkpoint "$container_ckpt")
      shift 2
      ;;
    *)
      opf_args+=("$1")
      shift
      ;;
  esac
done

exec docker run --rm -i "${tty_flag[@]+"${tty_flag[@]}"}" \
  -v "$OPF_CHECKPOINTS_PATH:/home/redact/.opf" \
  -v "$DOCLING_ARTIFACTS_PATH:/home/redact/.cache" \
  -v "$RAPIDOCR_MODELS_PATH:/opt/venv/lib/python3.11/site-packages/rapidocr/models" \
  "${file_mounts[@]+"${file_mounts[@]}"}" \
  "${host_dir_envs[@]+"${host_dir_envs[@]}"}" \
  "${env_flags[@]+"${env_flags[@]}"}" \
  "$IMAGE" $ADDITIONAL_DOCKER_RUN_ARGS "${opf_args[@]+"${opf_args[@]}"}"
