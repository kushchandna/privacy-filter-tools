# .env file is sourced by ./bin/redact if present.
# Use `export VAR=VAL` syntax.

# HuggingFace token for gated/private model downloads.
# export HF_TOKEN=hf_xxx

# Host directory mounted at /home/redact/.opf inside the container
# (where the privacy-filter checkpoint is cached). Defaults to .data/checkpoints.
# export REDACT_CHECKPOINT_DIR=/shared/checkpoints

# Override the image tag.
# export REDACT_IMAGE=redact:latest

# Additional arguments to pass to `docker run` when running the container.
# export REDACT_DOCKER_RUN_ARGS="--device cpu"
