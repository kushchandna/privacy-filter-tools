# .env file is sourced by ./bin/redact if present.

# HuggingFace token for gated/private model downloads.
# HF_TOKEN=hf_xxx

# Host directory where the privacy-filter checkpoint is cached.
# REDACT_CHECKPOINT_DIR=.data/checkpoints

# Override the image tag.
# REDACT_IMAGE=redact:latest

# Extra flags passed to `docker run` itself.
# REDACT_DOCKER_ARGS="--gpus all"

# Extra CLI arguments passed to redact-cli inside the container.
# REDACT_ARGS="--device cpu"
